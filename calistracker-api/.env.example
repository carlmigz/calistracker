APP_NAME="CalisTracker API"
APP_ENV=local
# Generate with: php artisan key:generate
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# PostgreSQL connection: either the separate values below...
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=calistracker
DB_USERNAME=postgres
DB_PASSWORD=postgres
# ...or one connection string, which takes priority if set (leave empty to use the values above)
DB_URL=
# Set to require for hosted databases that need SSL
DB_SSLMODE=prefer

# Logging: debug, info, warning, error. Files are written to storage/logs.
LOG_CHANNEL=stack
LOG_LEVEL=info
LOG_DAILY_DAYS=14

# Allowed CORS origins, comma separated. Use * to allow any origin.
CORS_ORIGIN=*

# Rate limiting, per IP: all requests, and login/register separately
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=20
# Set to true only when running behind a reverse proxy
TRUST_PROXY=false

# Bearer token lifetime in minutes (43200 = 30 days)
SANCTUM_TOKEN_EXPIRATION_MINUTES=43200
BCRYPT_ROUNDS=10

CACHE_STORE=file

# Path to the Flutter app's content file, used by the ProgramSeeder (relative to this folder)
PROGRAMS_JSON=../assets/data/programs.json
