PORT=3000
# PostgreSQL connection: either the separate values below...
DB_HOST=localhost
DB_PORT=5432
DB_NAME=calistracker
DB_USER=postgres
DB_PASSWORD=postgres
# ...or one connection string, which takes priority if set (leave empty to use the values above)
DATABASE_URL=
# Set to true only for hosted databases that require SSL
DATABASE_SSL=false
# Set to true to log every SQL statement
DATABASE_LOGGING=false
# Logging: error, warn, info, http, debug. Files are written to LOG_DIR.
LOG_LEVEL=http
LOG_DIR=logs
# Allowed CORS origins, comma separated. Use * to allow any origin.
CORS_ORIGIN=*
# Rate limiting, per IP: all requests, and login/register separately
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=20
# Set to true only when running behind a reverse proxy
TRUST_PROXY=false
# Change this to a long random string
JWT_SECRET=change-me
JWT_EXPIRES_IN=30d
# Path to the Flutter app's content file, used by db:seed (relative to this folder)
PROGRAMS_JSON=../assets/data/programs.json
